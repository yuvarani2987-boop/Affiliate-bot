# AI automation (optional; manual ChatGPT/Gemini/Flow mode still works without these)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_TEXT_MODEL=gpt-5-mini

GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_VIDEO_MODEL=veo-3.1-fast-generate-preview

# TikTok for Developers Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Example: https://YOUR-RENDER-SERVICE.onrender.com/api/tiktok/callback
TIKTOK_REDIRECT_URI=
TIKTOK_SCOPES=user.info.basic,video.publish

# Manual Google Flow mode (uses the Google account/Flow credits in the browser)
GOOGLE_FLOW_URL=https://labs.google/fx/tools/flow
